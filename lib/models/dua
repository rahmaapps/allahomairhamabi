// lib/models/dua.dart
class Dua {
  final int id;
  final String type;   // "رحمة" | "مغفرة" | "نور" | ...
  final String length; // "قصيرة" | "طويلة" | ...
  final String textAr;

  const Dua({
    required this.id,
    required this.type,
    required this.length,
    required this.textAr,
  });

  factory Dua.fromJson(Map<String, dynamic> json) {
    return Dua(
      id: json['id'] as int,
      type: (json['type'] ?? '').toString(),
      length: (json['length'] ?? '').toString(),
      textAr: (json['text_ar'] ?? '').toString(),
    );
  }
}