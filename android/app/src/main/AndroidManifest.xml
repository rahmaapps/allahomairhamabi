<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.joumane.allahomairhamabi">

    <!-- Android 13+ : permission de notifications (runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 12+ : alarme exacte pour les rappels planifiés
         (zonedSchedule / AndroidScheduleMode.exactAllowWhileIdle). Pas
         d'auto-octroi garanti à partir d'Android 14 — géré côté Dart avec
         repli en mode inexact si non accordée (NotificationService). Ne
         PAS utiliser USE_EXACT_ALARM : cette app n'est pas éligible à la
         catégorie « alarme/horloge » de la politique Play Store. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Requis par flutter_local_notifications pour reprogrammer les
         rappels planifiés après un redémarrage du téléphone
         (ScheduledNotificationBootReceiver ci-dessous). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application

        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <!-- Embedding Flutter v2 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Splash jusqu'au 1er frame -->
            <meta-data
                android:name="io.flutter.embedding.android.SplashScreenDrawable"
                android:resource="@drawable/launch_background" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receiver natif de flutter_local_notifications : reprogramme les
             rappels planifiés (zonedSchedule) après reboot. Doit être
             déclaré explicitement par l'app — non injecté par le
             manifest-merger, contrairement aux autres composants du plugin. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Receiver natif de flutter_local_notifications : reçoit l'alarme
             déclenchée par zonedSchedule() à l'heure programmée et affiche
             la notification. Ciblé par PendingIntent explicite (pas
             d'intent-filter nécessaire) — non injecté par le
             manifest-merger, comme confirmé par l'AndroidManifest.xml
             embarqué du plugin (aucun <receiver> déclaré côté plugin). Son
             absence empêchait toute livraison du broadcast à l'heure
             prévue, malgré une alarme correctement enregistrée. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />

        <!-- ⛔️ Ne PAS ajouter manuellement d'autre <service> ici : les
             plugins Flutter (flutter_local_notifications, etc.) injectent
             le reste via manifest-merger. -->

    </application>

</manifest>